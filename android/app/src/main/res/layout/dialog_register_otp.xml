<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/artifex_surface"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:src="@android:drawable/ic_dialog_info"
        app:tint="@color/artifex_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Xác thực số điện thoại"
        android:textColor="@color/artifex_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRegisterOtpPhoneDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Mã xác thực OTP (6 chữ số) đã được gửi qua SMS đến số điện thoại của bạn."
        android:textColor="@color/artifex_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvRegisterTargetPhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:text="098***1234"
        android:textColor="@color/artifex_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Ô nhập mã OTP 6 số -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilRegisterOtp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:textColorHint="@color/artifex_text_muted"
        app:boxBackgroundColor="@color/artifex_surface_variant"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/artifex_primary"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etRegisterOtp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:hint="• • • • • •"
            android:inputType="number"
            android:letterSpacing="0.3"
            android:maxLength="6"
            android:textColor="@color/artifex_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvRegisterResendCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gửi lại mã sau "
            android:textColor="@color/artifex_text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnRegisterResendOtp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:text="Gửi lại mã OTP"
            android:textColor="@color/artifex_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Nút Xác nhận & Hoàn tất -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmRegisterOtp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/artifex_primary"
        android:text="Xác nhận &amp; Tạo tài khoản"
        android:textColor="@color/artifex_on_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="12dp" />

    <!-- Nút Hủy -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelRegisterOtp"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:text="Hủy bỏ"
        android:textColor="@color/artifex_text_secondary"
        android:textSize="13sp" />

</LinearLayout>
