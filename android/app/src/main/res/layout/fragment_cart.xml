<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/artifex_bg"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_nav_cart"
        android:contentDescription="Cart Icon" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Giỏ Hàng &amp; Thanh Toán"
        android:textColor="@color/artifex_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Phụ trách: Bạn 4 (Cart / Giỏ hàng Room DB &amp; Đặt hàng)"
        android:textColor="@color/artifex_text_secondary"
        android:textSize="14sp" />

</LinearLayout>
