<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/artifex_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/artifex_border"
    app:strokeWidth="1dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="noExcludeDescendants"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvForgotTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khôi phục mật khẩu"
                android:textColor="@color/artifex_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvForgotSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Bước 1/2: Xác minh tài khoản để nhận mã OTP 6 chữ số"
                android:textColor="@color/artifex_text_secondary"
                android:textSize="13sp" />

            <!-- ==================== BƯỚC 1: XÁC MINH TÀI KHOẢN & NHẬN OTP ==================== -->
            <LinearLayout
                android:id="@+id/layoutForgotStep1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Tên đăng nhập (có thể để trống)"
                    android:textColorHint="@color/artifex_text_muted"
                    app:boxBackgroundColor="@color/artifex_surface_variant"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/artifex_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etForgotUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/artifex_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Số điện thoại nhận SMS thật (10 số)"
                    android:textColorHint="@color/artifex_text_muted"
                    app:boxBackgroundColor="@color/artifex_surface_variant"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/artifex_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etForgotContact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:textColor="@color/artifex_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancelForgotStep1"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="Hủy"
                        android:textColor="@color/artifex_text_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRequestOtp"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@color/artifex_primary"
                        android:text="Gửi SMS OTP"
                        android:textColor="@color/artifex_on_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ==================== BƯỚC 2: NHẬP MÃ OTP 6 SỐ & ĐẶT MẬT KHẨU MỚI ==================== -->
            <LinearLayout
                android:id="@+id/layoutForgotStep2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Thẻ trạng thái đã gửi SMS OTP (KHÔNG hiển thị lộ mã OTP trong form) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOtpBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/artifex_surface_variant"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/artifex_primary"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvOtpDeliveryStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Đã gửi tin nhắn SMS chứa mã OTP (6 chữ số) tới số điện thoại của bạn."
                            android:textColor="@color/artifex_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Vui lòng kiểm tra tin nhắn SMS trên điện thoại để lấy mã (Hiệu lực 5 phút)."
                            android:textColor="@color/artifex_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 1. Ô nhập mã OTP 6 chữ số -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Nhập mã OTP (6 chữ số)"
                    android:textColorHint="@color/artifex_text_muted"
                    app:boxBackgroundColor="@color/artifex_surface_variant"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/artifex_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etForgotOtpCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="6"
                        android:textColor="@color/artifex_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 2. Mật khẩu mới -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Mật khẩu mới (tối thiểu 6 ký tự)"
                    android:textColorHint="@color/artifex_text_muted"
                    app:boxBackgroundColor="@color/artifex_surface_variant"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/artifex_primary"
                    app:passwordToggleEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etForgotNewPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/artifex_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 3. Xác nhận mật khẩu mới -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Xác nhận lại mật khẩu mới"
                    android:textColorHint="@color/artifex_text_muted"
                    app:boxBackgroundColor="@color/artifex_surface_variant"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/artifex_primary"
                    app:passwordToggleEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etForgotConfirmPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/artifex_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBackToStep1"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="Quay lại"
                        android:textColor="@color/artifex_text_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubmitForgotPass"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@color/artifex_primary"
                        android:text="Đổi mật khẩu"
                        android:textColor="@color/artifex_on_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
