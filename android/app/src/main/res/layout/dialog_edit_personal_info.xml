<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/artifex_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:strokeColor="@color/artifex_border"
    app:strokeWidth="1dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chỉnh sửa thông tin cá nhân"
                android:textColor="@color/artifex_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Cập nhật thông tin hồ sơ của bạn"
                android:textColor="@color/artifex_text_secondary"
                android:textSize="13sp" />

            <!-- 1. Họ và tên -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Họ và tên"
                android:textColorHint="@color/artifex_text_muted"
                app:boxBackgroundColor="@color/artifex_surface_variant"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/artifex_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEditFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:textColor="@color/artifex_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 2. Email (Có thể thay đổi) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Địa chỉ Email"
                android:textColorHint="@color/artifex_text_muted"
                app:boxBackgroundColor="@color/artifex_surface_variant"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/artifex_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEditEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/artifex_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 3. Số điện thoại cá nhân -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Số điện thoại cá nhân"
                android:textColorHint="@color/artifex_text_muted"
                app:boxBackgroundColor="@color/artifex_surface_variant"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/artifex_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEditPersonalPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:textColor="@color/artifex_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 4. Ngày tháng năm sinh (Click để mở DatePickerDialog) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Ngày tháng năm sinh (dd/MM/yyyy)"
                android:textColorHint="@color/artifex_text_muted"
                app:boxBackgroundColor="@color/artifex_surface_variant"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/artifex_primary"
                app:endIconDrawable="@drawable/ic_calendar"
                app:endIconMode="custom"
                app:endIconTint="@color/artifex_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEditDob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:textColor="@color/artifex_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 5. Giới tính (Nam / Nữ / Khác) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Giới tính"
                android:textColor="@color/artifex_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbGenderMale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nam"
                    android:textColor="@color/artifex_text_primary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbGenderFemale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Nữ"
                    android:textColor="@color/artifex_text_primary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbGenderOther"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Khác"
                    android:textColor="@color/artifex_text_primary"
                    android:textSize="14sp" />
            </RadioGroup>

            <!-- Hàng nút hành động: Hủy & Lưu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelEditPersonal"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Hủy"
                    android:textColor="@color/artifex_text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveEditPersonal"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:text="Lưu thay đổi"
                    android:textColor="@color/artifex_on_primary"
                    app:backgroundTint="@color/artifex_primary"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
