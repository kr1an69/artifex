<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/artifex_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Thanh kéo nhỏ (Handle bar) -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@color/artifex_border" />

    <!-- Tiêu đề -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sổ địa chỉ nhận hàng"
        android:textColor="@color/artifex_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Chạm vào một địa chỉ để chọn làm địa chỉ giao hàng chính"
        android:textColor="@color/artifex_text_secondary"
        android:textSize="13sp" />

    <!-- Nút Thêm địa chỉ mới (Đặt ở trên để luôn hiển thị rõ ràng, không bao giờ bị danh sách đẩy trôi) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddNewAddress"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/artifex_primary"
        android:text="+ Thêm địa chỉ mới"
        android:textColor="@color/artifex_on_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="12dp" />

    <!-- Danh sách các địa chỉ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAddresses"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:nestedScrollingEnabled="true" />
</LinearLayout>
