<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/artifex_surface"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cập nhật thông tin"
        android:textColor="@color/artifex_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Thay đổi thông tin nhận hàng của bạn"
        android:textColor="@color/artifex_text_secondary"
        android:textSize="13sp" />

    <!-- Họ và tên -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEditFullName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColorHint="@color/artifex_text_muted"
        app:boxBackgroundColor="@color/artifex_surface_variant"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/artifex_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEditFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Họ và tên"
            android:inputType="textPersonName"
            android:textColor="@color/artifex_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Số điện thoại -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEditPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColorHint="@color/artifex_text_muted"
        app:boxBackgroundColor="@color/artifex_surface_variant"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/artifex_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEditPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Số điện thoại"
            android:inputType="phone"
            android:textColor="@color/artifex_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Địa chỉ nhận hàng -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilEditAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColorHint="@color/artifex_text_muted"
        app:boxBackgroundColor="@color/artifex_surface_variant"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/artifex_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEditAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Địa chỉ nhận hàng"
            android:inputType="textPostalAddress"
            android:textColor="@color/artifex_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Nhóm Nút Hủy / Lưu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelEdit"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Hủy"
            android:textColor="@color/artifex_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveProfile"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/artifex_primary"
            android:text="Lưu thay đổi"
            android:textColor="@color/artifex_on_primary"
            app:cornerRadius="12dp" />
    </LinearLayout>
</LinearLayout>
