<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/artifex_bg"
    android:orientation="vertical">

    <!-- 1. Header / Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/artifex_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <!-- Nút Quay lại (chỉ hiển thị khi mở qua OrderHistoryActivity từ màn Profile) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBackOrderHistory"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:cardBackgroundColor="@color/artifex_surface_variant"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/artifex_border"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Quay lại"
                android:rotation="180"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/artifex_text_primary" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/oxanium_bold"
                android:letterSpacing="0.08"
                android:text="ARTIFEX"
                android:textColor="@color/artifex_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lịch sử đơn hàng"
                android:textColor="@color/artifex_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOrderHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Đang tải dữ liệu đơn hàng..."
                android:textColor="@color/artifex_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Nút Làm mới (Refresh) danh sách đơn hàng -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefreshOrders"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Làm mới"
            android:textAllCaps="false"
            android:textColor="@color/artifex_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:strokeColor="@color/artifex_primary"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- 2. Thanh Filter trạng thái đơn hàng (Pill Chips bo góc 20dp) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/artifex_surface"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Tất cả"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipFilterPending"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Chờ xác nhận"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipFilterShipping"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Đang vận chuyển"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipFilterCompleted"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Hoàn thành"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipFilterCancelled"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Đã hủy"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="20dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Đường viền phân cách dưới thanh Header & Filter -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/artifex_border" />

    <!-- 3. Banner thông báo khi chạy chế độ Demo Offline (tự ẩn khi Backend Spring Boot đang bật) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardOfflineNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/artifex_surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/artifex_accent"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvOfflineNoticeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chế độ Demo Offline: Hiển thị dữ liệu mẫu để kiểm thử UI (Bấm Làm mới khi đã bật Backend)."
                android:textColor="@color/artifex_accent"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 4. Khu vực nội dung chính (RecyclerView / Loading / Empty State) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Danh sách các thẻ đơn hàng -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOrderHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp" />

        <!-- Trạng thái rỗng (Empty State) -->
        <LinearLayout
            android:id="@+id/layoutOrderEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="72dp"
                android:layout_height="72dp"
                app:cardBackgroundColor="@color/artifex_surface"
                app:cardCornerRadius="36dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/artifex_border"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:contentDescription="Không có đơn hàng"
                    android:src="@drawable/ic_nav_cart"
                    app:tint="@color/artifex_text_muted" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvOrderEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Chưa có đơn hàng nào"
                android:textColor="@color/artifex_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOrderEmptySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Các đơn hàng linh kiện PC của bạn thuộc trạng thái này sẽ xuất hiện tại đây."
                android:textColor="@color/artifex_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Vòng xoay Loading khi đang gọi API -->
        <ProgressBar
            android:id="@+id/progressOrderLoading"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/artifex_primary"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
