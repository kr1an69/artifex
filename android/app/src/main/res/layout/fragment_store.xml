<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/artifex_bg"
    android:orientation="vertical">

    <!-- 1. Header / Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/artifex_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/oxanium_bold"
                android:letterSpacing="0.08"
                android:text="ARTIFEX"
                android:textColor="@color/artifex_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStoreHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hệ thống Showroom"
                android:textColor="@color/artifex_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStoreHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Đang tải danh sách chi nhánh..."
                android:textColor="@color/artifex_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Nút Làm mới (Refresh) danh sách Showroom -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefreshStores"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Làm mới"
            android:textAllCaps="false"
            android:textColor="@color/artifex_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:strokeColor="@color/artifex_primary"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- Đường viền phân cách dưới Header -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/artifex_border" />

    <!-- 2. Banner thông báo khi chạy chế độ Demo Offline (tự ẩn khi Backend Spring Boot đang bật) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStoreOfflineNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/artifex_surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/artifex_accent"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvStoreOfflineNoticeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chế độ Demo Offline: Hiển thị 4 showroom mẫu (Bấm Làm mới khi đã bật Backend)."
                android:textColor="@color/artifex_accent"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 3. Khung Bản đồ OpenStreetMap (osmdroid) bo góc 16dp (có Slot cố định để hỗ trợ phóng to Dialog) -->
    <FrameLayout
        android:id="@+id/mapSlotContainer"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMapContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="@color/artifex_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/artifex_border"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <org.osmdroid.views.MapView
                    android:id="@+id/mapViewStores"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Nút Phóng to / Thu nhỏ bản đồ (góc trên bên phải) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleMapExpand"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:contentDescription="Phóng to bản đồ"
                    android:elevation="4dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@color/artifex_surface"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_map_expand"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/artifex_text_primary"
                    app:strokeColor="@color/artifex_border"
                    app:strokeWidth="1dp" />

                <!-- Cụm nút Zoom + / - (chỉ hiển thị khi phóng to bản đồ) -->
                <LinearLayout
                    android:id="@+id/layoutMapZoomControls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMapZoomIn"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginBottom="8dp"
                        android:contentDescription="Phóng to"
                        android:elevation="4dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        app:backgroundTint="@color/artifex_surface"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_plus"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="20dp"
                        app:iconTint="@color/artifex_text_primary"
                        app:strokeColor="@color/artifex_border"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMapZoomOut"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="Thu nhỏ"
                        android:elevation="4dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        app:backgroundTint="@color/artifex_surface"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_minus"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="20dp"
                        app:iconTint="@color/artifex_text_primary"
                        app:strokeColor="@color/artifex_border"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <!-- Nút Định vị GPS & Tính khoảng cách đa luồng -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLocateNearest"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="12dp"
                    android:backgroundTint="@color/artifex_primary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Định vị gần nhất"
                    android:textAllCaps="false"
                    android:textColor="@color/artifex_on_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_location"
                    app:iconSize="16dp"
                    app:iconTint="@color/artifex_on_primary" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- 4. Banner hiển thị Showroom gần nhất (Kết quả từ ExecutorService Worker Thread) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNearestStoreBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/artifex_surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/artifex_primary"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvNearestStoreBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gần bạn nhất: Đang xác định tọa độ GPS..."
                android:textColor="@color/artifex_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMultithreadStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="ExecutorService: Sẵn sàng tính khoảng cách ngầm trên Worker Thread"
                android:textColor="@color/artifex_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Đường phân cách nhẹ giữa phần cố định và danh sách cuộn -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/artifex_border" />

    <!-- 5. Danh sách các Showroom đã sắp xếp theo khoảng cách -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvStores"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp" />

        <ProgressBar
            android:id="@+id/progressStoreLoading"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/artifex_primary"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
