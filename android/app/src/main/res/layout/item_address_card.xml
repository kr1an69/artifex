<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardAddressItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/artifex_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/artifex_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Hàng 1: Tên người nhận + Tags + Nút Xóa -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_nav_auth"
                app:tint="@color/artifex_primary" />

            <TextView
                android:id="@+id/tvItemReceiverName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Nguyễn Văn A"
                android:textColor="@color/artifex_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Tag Nhà riêng / Văn phòng -->
            <TextView
                android:id="@+id/tvItemTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/artifex_surface_variant"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="🏠 Nhà riêng"
                android:textColor="@color/artifex_text_secondary"
                android:textSize="11sp" />

            <!-- Badge Mặc định -->
            <TextView
                android:id="@+id/tvItemDefaultBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@color/artifex_primary"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="MẶC ĐỊNH"
                android:textColor="@color/artifex_on_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Nút Xóa địa chỉ -->
            <ImageButton
                android:id="@+id/btnItemDelete"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_trash"
                app:tint="@color/artifex_text_muted" />
        </LinearLayout>

        <!-- Đường phân cách nhẹ giữa thông tin tên và liên lạc -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@color/artifex_border" />

        <!-- Hàng 2: Icon Phone + Số điện thoại -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_phone"
                app:tint="@color/artifex_primary" />

            <TextView
                android:id="@+id/tvItemPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="0901 234 567"
                android:textColor="@color/artifex_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Hàng 3: Icon Location + Địa chỉ chi tiết -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="top"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/ic_location"
                app:tint="@color/artifex_primary" />

            <TextView
                android:id="@+id/tvItemAddressLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Khu phố 6, P. Linh Trung, TP. Thủ Đức, TP.HCM"
                android:textColor="@color/artifex_text_primary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
