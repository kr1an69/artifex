<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/artifex_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Title Header -->
    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Viết Đánh Giá Sản Phẩm"
        android:textColor="@color/artifex_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Chia sẻ cảm nhận thực tế để nhận ưu đãi và giúp khách hàng khác chọn mua."
        android:textColor="@color/artifex_text_muted"
        android:textSize="13sp" />

    <!-- Rating Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="vertical">

        <RatingBar
            android:id="@+id/ratingBarInput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:progressTint="@color/artifex_accent"
            android:rating="5"
            android:stepSize="1.0" />

        <TextView
            android:id="@+id/tvRatingHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tuyệt vời (5 sao)"
            android:textColor="@color/artifex_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Quick Review Suggestions (Shopee Quick Tag Chips) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Gợi ý đánh giá nhanh (bấm để thêm):"
        android:textColor="@color/artifex_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tagQuality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pill"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="⭐ Chất lượng tuyệt vời"
                android:textColor="@color/artifex_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tagPackaging"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_pill"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="📦 Đóng gói cẩn thận"
                android:textColor="@color/artifex_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tagFastDelivery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_pill"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="⚡ Giao hàng siêu nhanh"
                android:textColor="@color/artifex_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tagGoodPerformance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_pill"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="🔥 Hiệu năng cực mượt"
                android:textColor="@color/artifex_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Comment Input Field with Character Counter (Shopee Standard) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilComment"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Nhận xét chi tiết về sản phẩm..."
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/artifex_primary"
        app:counterEnabled="true"
        app:counterMaxLength="500"
        app:hintTextColor="@color/artifex_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:lines="4"
            android:maxLines="6"
            android:textColor="@color/artifex_text_primary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Pick Image Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSelectImage"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:text="Thêm ảnh chụp thực tế (tùy chọn)"
        android:textColor="@color/artifex_primary"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_add_photo"
        app:iconGravity="textStart"
        app:iconTint="@color/artifex_primary"
        app:strokeColor="@color/artifex_primary"
        app:strokeWidth="1dp" />

    <!-- Image Preview Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardImagePreview"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/artifex_border"
        app:strokeWidth="1dp"
        tools:visibility="visible">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imgPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Image Preview"
                android:scaleType="centerCrop" />

            <!-- Remove Image Button -->
            <ImageView
                android:id="@+id/btnRemoveImage"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_circle_primary"
                android:contentDescription="Remove image"
                android:padding="6dp"
                android:src="@drawable/ic_trash"
                app:tint="@color/white" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Upload Progress Indicator -->
    <ProgressBar
        android:id="@+id/progressBarReview"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/artifex_primary"
        android:visibility="gone" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelReview"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Hủy"
            android:textColor="@color/artifex_text_secondary"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitReview"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/artifex_primary"
            android:text="Gửi Đánh Giá"
            android:textColor="@color/artifex_on_primary"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
